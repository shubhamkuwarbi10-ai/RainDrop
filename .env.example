# RainDrop environment configuration.
# Copy to .env and fill in real values. Never commit .env.
#
# Generate the two secrets with:
#   openssl rand -base64 32

# ── Environment ──────────────────────────────────────────────
# "production" makes missing secrets a startup error and disables /docs.
RAINDROP_ENV=development

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=raindrop
POSTGRES_USER=raindrop
# Required. docker compose refuses to start without it.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg2://raindrop:CHANGE_ME@db:5432/raindrop

# ── Secrets ──────────────────────────────────────────────────
# Signs operator session cookies. Changing it signs everyone out.
RAINDROP_SESSION_SECRET=
# Shared secret the pipeline presents as X-API-Key on write endpoints.
RAINDROP_INGEST_KEY=
# Session lifetime in minutes.
RAINDROP_SESSION_TTL_MINUTES=480
# Set true only once HTTPS terminates in front of the app.
RAINDROP_SESSION_COOKIE_SECURE=false

# ── API behaviour ────────────────────────────────────────────
# Interactive docs list every write route. Keep false in production.
ENABLE_API_DOCS=true
# Seconds to cache an Open-Meteo response per rounded coordinate.
OPEN_METEO_CACHE_SECONDS=300
OPEN_METEO_TIMEZONE=Asia/Kolkata
# A reading older than this is reported as stale to the UI.
RAINDROP_STALE_AFTER_SECONDS=600

# ── Ports ────────────────────────────────────────────────────
# Only the web port is published. The database and backend are reachable
# on the compose network only.
WEB_PORT=80
