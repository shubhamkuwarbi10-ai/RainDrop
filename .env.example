# RainDrop GIS Environment Configuration
# Copy this file to .env or use defaults

# PostgreSQL / PostGIS Database Settings
POSTGRES_DB=raindrop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/raindrop

# ML & GIS Service URL (used by backend container)
ML_API_URL=http://ml-server:8000

# Backend Service URL
BACKEND_API_URL=http://backend:8001

# Web Server Ports
WEB_PORT=80
ML_PORT=8000
BACKEND_PORT=8001
