# RainDrop GIS - Sample Environment Configuration
# Copy this file to .env and configure for your local/production environment

# Database Settings
POSTGRES_DB=raindrop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@db:5432/raindrop

# Application Services
ML_API_URL=http://ml-server:8000
APP_ENV=production
SECRET_KEY=change_this_to_a_random_32_character_secret_key
