# ─────────────────────────────────────────────────────────────
# RainDrop GIS — Environment Variables Template
# Copy this to .env and fill in real values before running.
# NEVER commit the actual .env file to git.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL / PostGIS ──────────────────────────────────────
POSTGRES_DB=raindrop
POSTGRES_USER=postgres
# CHANGE THIS in production — use a strong random password
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=postgres

# ── Database Connection URL ───────────────────────────────────
# For local Docker: use container name "db" as host
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/raindrop

# For local development (no Docker): use localhost
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/raindrop

# ── ML / GIS Server ───────────────────────────────────────────
# For Docker: use container name "ml-server" as host
ML_API_URL=http://ml-server:8000

# For local development (no Docker): use localhost
# ML_API_URL=http://127.0.0.1:8000

# ── Application ───────────────────────────────────────────────
# Environment: development | production
APP_ENV=production

# Secret key for session signing etc.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-secret-key

# ── AWS (for cloud deployment) ────────────────────────────────
# Only needed if using S3 for raster storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=raindrop-data